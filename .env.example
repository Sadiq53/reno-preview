# PostgreSQL Connection String (Aiven Cloud / Neon / Supabase)
DATABASE_URL="postgres://user:password@host:port/dbname?sslmode=require"

# Auth.js / NextAuth Configuration
# For local dev: http://localhost:3000 | For production: https://vanguard.crewvia.in
NEXTAUTH_URL="https://vanguard.crewvia.in"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-hex-or-base64-secret"

# Master Encryption Key (32-byte / 64-hex-character string for AES-256-GCM Vault)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application Public Base URL
NEXT_PUBLIC_APP_URL="https://vanguard.crewvia.in"

# Firebase Cloud Messaging & Storage Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="vanguard-ffbb1.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="vanguard-ffbb1"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="vanguard-ffbb1.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

FIREBASE_PROJECT_ID="vanguard-ffbb1"
FIREBASE_STORAGE_BUCKET="vanguard-ffbb1.firebasestorage.app"
# For Vercel Production: Paste the entire content of serviceAccountKey.json into this single variable:
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", ...}'
# For Local Development:
FIREBASE_SERVICE_ACCOUNT_PATH="serviceAccountKey.json"

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="notifications@crewvia.com"
BREVO_SENDER_NAME="Crewvia Vanguard"
